# ============================================================
# 주간 보스 이벤트 스크립트
# 매주 정해진 시간에 보스 소환
# ============================================================

# ============================================================
# 변수 초기화
# ============================================================
on load:
	# {boss.event.active} - 보스 이벤트 진행 중 여부
	# {boss.event.location} - 보스 소환 위치
	# {boss.event.participants::*} - 참가자 목록

# ============================================================
# 주간 보스 이벤트 - 매주 토요일 오후 8시
# ============================================================
# 실제 시간 기반은 외부 스케줄러 필요
# 테스트를 위한 수동 명령어 제공

# ============================================================
# 보스 이벤트 시작 명령어 (관리자 전용)
# ============================================================
command /보스이벤트 [<text>]:
	aliases: /bossevent
	permission: admin.bossevent
	permission message: &c권한이 없습니다.
	trigger:
		if arg-1 is "start" or "시작":
			if {boss.event.active} is true:
				send "&c이미 보스 이벤트가 진행 중입니다!" to player
				stop
			
			# 이벤트 시작
			set {boss.event.active} to true
			set {boss.event.location} to player's location
			clear {boss.event.participants::*}
			
			# 전체 공지
			broadcast "&4&l━━━━━━━━━━━━━━━━━━━━━━━━━━"
			broadcast "&6&l    주간 보스 이벤트 시작!"
			broadcast "&e드레이크가 소환되었습니다!"
			broadcast "&7위치: %x-coordinate of player's location%, %y-coordinate of player's location%, %z-coordinate of player's location%"
			broadcast "&4&l━━━━━━━━━━━━━━━━━━━━━━━━━━"
			
			# 모든 플레이어에게 사운드 재생
			loop all players:
				play sound "entity.ender_dragon.growl" to loop-player with volume 2
				send title "&4드레이크 출현!" with subtitle "&e보스 레이드 참여하세요!" to loop-player for 5 seconds
			
			# 보스 소환 (MythicMobs 드레이크)
			wait 3 seconds
			# 주의: 좌표 형식은 MythicMobs 버전에 따라 다를 수 있습니다
			set {_x} to x-coordinate of player's location
			set {_y} to y-coordinate of player's location
			set {_z} to z-coordinate of player's location
			set {_world} to world of player
			execute console command "mm mobs spawn drake 1 %{_world}%,%{_x}%,%{_y}%,%{_z}%"
			
			# 참가자 추적 시작
			wait 5 seconds
			bossEventTracking()
		
		else if arg-1 is "stop" or "종료":
			set {boss.event.active} to false
			broadcast "&c[보스 이벤트] 이벤트가 종료되었습니다."
		
		else:
			send "&e/보스이벤트 시작 &7- 보스 이벤트 시작" to player
			send "&e/보스이벤트 종료 &7- 보스 이벤트 종료" to player

# ============================================================
# 보스 이벤트 참가자 추적 함수
# ============================================================
function bossEventTracking():
	while {boss.event.active} is true:
		# 보스 근처 플레이어 확인 (반경 50블록)
		loop all players:
			if distance between loop-player and {boss.event.location} <= 50:
				if {boss.event.participants::%loop-player%} is not set:
					set {boss.event.participants::%loop-player%} to true
					send "&a[보스 이벤트] 참가 등록되었습니다!" to loop-player
		
		wait 5 seconds

# ============================================================
# 보스 처치 시 보상 (MythicMobs 이벤트 필요)
# ============================================================
# MythicMobs의 drake가 처치되었을 때
on death of ender dragon:
	if {boss.event.active} is true:
		# 이벤트 종료
		set {boss.event.active} to false
		
		# 전체 공지
		broadcast "&6&l━━━━━━━━━━━━━━━━━━━━━━━━━━"
		broadcast "&a&l  드레이크가 처치되었습니다!"
		if attacker is a player:
			broadcast "&e결정타: &a%attacker%"
		broadcast "&6&l━━━━━━━━━━━━━━━━━━━━━━━━━━"
		
		# 참가자 보상
		loop {boss.event.participants::*}:
			set {_p} to loop-index parsed as player
			if {_p} is online:
				# 보상 지급
				add 10000 to balance of {_p}
				send "&a[보상] 10,000 아데나를 받았습니다!" to {_p}
				
				# MMOCore 경험치 지급 (명령어 실행)
				execute console command "mmocore admin experience add %{_p}% 500"
				send "&a[보상] 500 경험치를 받았습니다!" to {_p}
				
				# 아이템 보상
				give {_p} diamond named "&6보스 전리품" with lore "&7드레이크 처치 기념품"
				
				play sound "ui.toast.challenge_complete" to {_p}
		
		# 참가자 목록 초기화
		clear {boss.event.participants::*}

# ============================================================
# 이벤트 알림 (매주 토요일 오후 7시 30분 - 30분 전 예고)
# ============================================================
# 실제 스케줄링은 서버 cron job 또는 다른 스케줄러 사용
# 테스트 명령어:
command /보스알림:
	permission: admin.bossevent
	trigger:
		broadcast "&e━━━━━━━━━━━━━━━━━━━━━━━━━━"
		broadcast "&6[알림] 30분 후 주간 보스 이벤트가 시작됩니다!"
		broadcast "&e드레이크가 소환될 예정입니다."
		broadcast "&7준비하세요!"
		broadcast "&e━━━━━━━━━━━━━━━━━━━━━━━━━━"
		
		loop all players:
			play sound "block.note_block.pling" to loop-player with pitch 2

# ============================================================
# 이벤트 상태 확인 명령어
# ============================================================
command /보스상태:
	trigger:
		if {boss.event.active} is true:
			send "&a보스 이벤트가 진행 중입니다!" to player
			send "&7참가자 수: &e%size of {boss.event.participants::*}%명" to player
			send "&7위치: %{boss.event.location}%" to player
		else:
			send "&c현재 보스 이벤트가 진행 중이 아닙니다." to player
